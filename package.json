{
  "name": "@solirius/create-cypress",
  "version": "1.0.1",
  "description": "CLI to scaffold a Cypress test project",
  "keywords": [
    "create",
    "cypress",
    "cli",
    "scaffold"
  ],
  "type": "module",
  "main": "bin/cli.js",
  "bin": {
    "create-cypress": "bin/cli.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\" \"bin/**/*.js\" \"templates/**/*.{js,mjs,ts,json}\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"bin/**/*.js\" \"templates/**/*.{js,mjs,ts,json}\" \"*.js\"",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.0",
    "chalk": "^5.6.2",
    "execa": "^9.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperry189/cypress-scaffold"
  }
}
